---
import SocialIcons from "./SocialIcons.astro";
---

<footer class="site-footer" role="contentinfo" aria-label="Footer">
  <div class="footer-left">
    <small>
    &copy; {new Date().getFullYear()} &middot;
    <a class="link" href="/rss.xml" type="application/rss+xml">RSS</a> &middot;
    <a class="link" href="/atom.xml" type="application/atom+xml">Atom</a> &middot;
    <a class="link" href="#" id="manage-cookies-link">Manage cookies</a>
    </small>
  </div>
  <div class="footer-right">
    <SocialIcons size={24} className="footer-socials" />
  </div>

  <style>
    .site-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 18px clamp(16px, 4vw, 32px);
      border-top: 1px solid var(--rule);
      background: var(--bg);
    }

    .footer-left { display: flex; align-items: center; gap: 12px; }
    .footer-right { color: var(--muted); font-size: 0.95rem; }
    .footer-socials { --social-size: 26px; }

    @media (max-width: 700px) {
      .site-footer {
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 10px;
        padding: 14px;
      }
      .footer-left, .footer-right { width: 100%; display: flex; justify-content: center; }
    }
  </style>

  <script is:inline>
    (function(){
      var link = document.getElementById('manage-cookies-link');
      if (!link) return;
      link.addEventListener('click', function(e) {
        e.preventDefault();
        if (window.klaro) window.klaro.show();
      });
    })();
  </script>
</footer>
