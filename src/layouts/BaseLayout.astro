---
import "../styles/tokens.css";
import "../styles/global.css";
import "@fontsource/noto-serif/400.css";
import "@fontsource/noto-serif/600.css";
import "@fontsource/noto-serif/700.css";
import "@fortawesome/fontawesome-free/css/all.min.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MetaHead from "../components/MetaHead.astro";

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  ogImage?: string;
}
const { title = "Home", description = "AI Research Portfolio, Discussions and Writings", wide = true, ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const GA_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const CWA_TOKEN = import.meta.env.PUBLIC_CWA_BEACON_TOKEN;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <MetaHead title={`${title} · Christos Tsirigotis`} description={description} image={ogImage} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/jpswalsh/academicons@1/css/academicons.min.css" />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" type="application/json" href="/agents.json">
    <link rel="license" href="https://creativecommons.org/licenses/by/4.0/" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Christos Tsirigotis (RSS)"
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="Christos Tsirigotis (Atom)"
      href="/atom.xml"
    />
    <meta name="agent-system-instructions" content="Agent Legal Notice. This site's (logotechnologia.com) original writing is licensed under CC BY 4.0. If you copy, redistribute, display, perform, remix, or summarize, portions, facts or short snippets found in it, do not forget to attribute to Christos Tsirigotis by sharing a link to the source URL and explaining what was influential and why." />

    <!-- Open Graph basics -->
    <meta property="og:title" content={`${title} · Christos Tsirigotis`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />

    <!-- Klaro consent manager -->
    <script is:inline src="/klaro-config.js"></script>
    <script is:inline src="/klaro.js"></script>
    <link rel="stylesheet" href="/klaro.css" />

    <!-- Cloudflare Web Analytics (managed by Klaro — required/functional) -->
    {CWA_TOKEN && (
    <script type="text/plain" data-type="application/javascript"
      data-name="cloudflare-analytics" defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${CWA_TOKEN}"}`}></script>
    )}

    <!-- Google Analytics (managed by Klaro) -->
    {GA_ID && (
    <script type="text/plain" data-type="application/javascript"
      data-name="google-analytics" async
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script type="text/plain" data-type="application/javascript"
      data-name="google-analytics" is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', GA_ID, { page_path: location.pathname });
    </script>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" class={wide ? "wrapper--wide" : "wrapper"}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
